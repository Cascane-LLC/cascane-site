---
// One voice message, always identical; a single extra element shows a feature.
// The extra is absolutely positioned so the base message never moves.
import '../../styles/illo.css';
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import AvatarBubble from '../AvatarBubble.astro';
import VoicePill from '../VoicePill.astro';
import natalie from '../../assets/avatars/natalie.png';
import nate from '../../assets/avatars/nate.png';
import starspace from '../../assets/photos/starspace.png';

export type Variant = 'reactions' | 'receipts' | 'replies' | 'photo' | 'timers' | 'presence';
interface Props { variant: Variant }
const { variant } = Astro.props;
---
<div class="msg" aria-hidden="true">
  <div class="base">
    <AvatarBubble src={natalie} size={32} online={variant === 'presence'} />
    <VoicePill duration="0:24" seed={4} bars={16} />
  </div>
  {variant === 'reactions' && <span class="x badge">😂 4</span>}
  {variant === 'receipts' && <span class="x below meta accent"><Icon name="headphones" size={14} />Heard by 16</span>}
  {variant === 'replies' && (
    <div class="x below reply">
      <AvatarBubble src={nate} size={22} />
      <VoicePill duration="0:07" seed={6} bars={8} />
    </div>
  )}
  {variant === 'photo' && <Image src={starspace} alt="" width={64} height={64} densities={[1, 2]} class="x above photo" />}
  {variant === 'timers' && <span class="x below chip chip-accent"><Icon name="timer" size={14} />23h left</span>}
  {variant === 'presence' && <span class="x below meta online-label">Online now</span>}
</div>
<style>
  .msg { position: relative; display: inline-block; }
  .base { display: flex; align-items: center; gap: 10px; }
  .x { position: absolute; }
  .below { top: calc(100% + 12px); left: 50px; }
  .above { bottom: calc(100% + 12px); left: 50px; }
  .badge { top: -14px; right: -12px; display: inline-flex; align-items: center; height: 26px; padding: 0 9px; border-radius: var(--r-pill); background: var(--surface-2); font-size: 0.8125rem; color: var(--text); box-shadow: inset 0 0 0 1px var(--line-strong), 0 6px 16px rgba(0, 0, 0, 0.5); }
  .accent { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); white-space: nowrap; }
  .reply { display: flex; align-items: center; gap: 8px; padding-left: 14px; border-left: 2px solid var(--line-strong); }
  .reply :global(.pill) { height: 32px; --wave-h: 14px; }
  .reply :global(.pill .play) { width: 22px; height: 22px; }
  .msg :global(.photo) { border-radius: 14px; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5); }
  .online-label { color: var(--accent-3); font-weight: 600; }
</style>
