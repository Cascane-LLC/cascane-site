---
// TEMPORARY comparison page for choosing the details-section design.
// Unlisted (noindex, not in the sitemap); remove once an option is chosen.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MessageArt from '../components/options/MessageArt.astro';

const items = [
  { key: 'reactions', icon: 'smile', title: 'Reactions', text: 'Answer with an emoji when a voice message deserves one, and see who reacted with what.' },
  { key: 'receipts', icon: 'headphones', title: 'Listen receipts', text: "Every message shows who's heard it, so you're never left wondering." },
  { key: 'replies', icon: 'reply', title: 'Threaded voice replies', text: 'Reply to one specific message. Replies stay threaded under it, so busy chats stay easy to follow.' },
  { key: 'photo', icon: 'image', title: 'Photo + voice', text: 'Attach a photo to any voice message and say what it is at the same time.' },
  { key: 'timers', icon: 'timer', title: 'Disappearing messages', text: "Pick a timer from 1 to 24 hours, or keep a message forever. When time's up, it's gone." },
  { key: 'presence', icon: 'circle-dot', title: 'Online now', text: "A green dot shows who's around right now." },
] as const;
---
<Base title="Details section options · Cascane" description="Temporary comparison of four designs for the details section of the Cascane website. Not part of the published site." path="/details-options" noindex>
  <header class="container page-top intro">
    <p class="eyebrow">Design options (temporary page)</p>
    <h1 class="display-sm">Four ways to show the details.</h1>
    <p class="lead">Same six features, same copy. Only the presentation changes.</p>
  </header>

  <!-- Option 1 -->
  <section class="section opt">
    <div class="container">
      <p class="tag">Option 1 · Same message, one change (recommended)</p>
      <h2 class="h2">More than a voice message.</h2>
      <ul class="grid3">
        {items.map((it) => (
          <li class="tile">
            <div class="frame"><MessageArt variant={it.key} /></div>
            <h3 class="h3">{it.title}</h3>
            <p>{it.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Option 2 -->
  <section class="section opt">
    <div class="container">
      <p class="tag">Option 2 · One big visual, feature list (tap or hover a feature)</p>
      <h2 class="h2">More than a voice message.</h2>
      <div class="show" data-showcase>
        <ul class="list">
          {items.map((it, i) => (
            <li>
              <button type="button" class="feat" aria-pressed={i === 0 ? 'true' : 'false'} data-key={it.key}>
                <span class="feat-title">{it.title}</span>
                <span class="feat-text">{it.text}</span>
              </button>
            </li>
          ))}
        </ul>
        <div class="stage">
          {items.map((it, i) => (
            <div class="stage-art" data-art={it.key} hidden={i !== 0}><MessageArt variant={it.key} /></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Option 3 -->
  <section class="section opt">
    <div class="container">
      <p class="tag">Option 3 · Equal tiles, one large icon each</p>
      <h2 class="h2">More than a voice message.</h2>
      <ul class="grid3">
        {items.map((it) => (
          <li class="tile">
            <div class="frame"><span class="glyph"><Icon name={it.icon} size={40} /></span></div>
            <h3 class="h3">{it.title}</h3>
            <p>{it.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Option 4 -->
  <section class="section opt">
    <div class="container">
      <p class="tag">Option 4 · Text only</p>
      <div class="textgrid">
        <h2 class="h2">More than a voice message.</h2>
        <ol class="textlist">
          {items.map((it, i) => (
            <li>
              <span class="num">0{i + 1}</span>
              <div><h3 class="h3">{it.title}</h3><p>{it.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((root) => {
    const feats = [...root.querySelectorAll<HTMLButtonElement>('.feat')];
    const arts = [...root.querySelectorAll<HTMLElement>('[data-art]')];
    const show = (key: string) => {
      feats.forEach((f) => f.setAttribute('aria-pressed', String(f.dataset.key === key)));
      arts.forEach((a) => { a.hidden = a.dataset.art !== key; });
    };
    feats.forEach((f) => {
      f.addEventListener('click', () => show(f.dataset.key!));
      f.addEventListener('mouseenter', () => show(f.dataset.key!));
    });
  });
</script>

<style>
  .intro { display: grid; gap: 16px; }
  .opt { border-top: 1px solid var(--line); }
  .tag { display: inline-block; font-size: 0.8125rem; font-weight: 600; color: #000; background: var(--accent); border-radius: var(--r-pill); padding: 6px 12px; margin-bottom: 20px; }
  .opt .h2 { margin-bottom: 40px; }

  /* Options 1 and 3: equal tiles, identical art frames */
  .grid3 { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .tile { display: grid; grid-template-rows: auto auto 1fr; gap: 8px; padding: 12px 12px 28px; border-radius: var(--r-panel); background: linear-gradient(180deg, #131317, #0E0E11); box-shadow: inset 0 0 0 1px var(--line); }
  .tile h3, .tile p { padding-inline: 16px; }
  .tile h3 { margin-top: 12px; }
  .tile p { color: var(--text-2); }
  /* padding-top shifts every message down equally so the photo (option 1) clears the frame top. */
  .frame { height: 200px; padding-top: 28px; display: grid; place-items: center; border-radius: 20px; background: radial-gradient(120% 90% at 50% 0%, rgba(0, 217, 255, 0.1), rgba(0, 217, 255, 0) 60%), rgba(255, 255, 255, 0.015); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04); overflow: hidden; }
  .glyph { width: 96px; height: 96px; display: grid; place-items: center; border-radius: 28px; color: var(--accent); background: rgba(0, 217, 255, 0.08); box-shadow: inset 0 0 0 1px rgba(0, 217, 255, 0.25), 0 0 60px rgba(0, 217, 255, 0.18); }

  /* Option 2: list + one large stage */
  .show { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 32px; align-items: stretch; }
  .list { list-style: none; padding: 0; display: grid; gap: 4px; }
  .feat { width: 100%; text-align: left; display: grid; gap: 4px; padding: 16px 20px; border-radius: 16px; transition: background-color 0.2s; }
  .feat-title { font-weight: 600; font-size: 1.0625rem; color: var(--text-3); }
  .feat-text { display: none; color: var(--text-2); }
  .feat[aria-pressed='true'] { background: var(--surface-1); box-shadow: inset 0 0 0 1px var(--line); }
  .feat[aria-pressed='true'] .feat-title { color: var(--text); }
  .feat[aria-pressed='true'] .feat-text { display: block; }
  .stage { min-height: 460px; display: grid; place-items: center; border-radius: var(--r-panel); background: radial-gradient(90% 70% at 50% 30%, rgba(0, 217, 255, 0.12), rgba(0, 217, 255, 0) 70%), linear-gradient(180deg, #131317, #0E0E11); box-shadow: inset 0 0 0 1px var(--line); }
  .stage-art { transform: scale(1.6); }
  .stage-art[hidden] { display: none; }

  /* Option 4: text only */
  .textgrid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 48px; align-items: start; }
  .textlist { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 40px; }
  .textlist li { display: grid; grid-template-columns: auto 1fr; gap: 14px; }
  .textlist p { color: var(--text-2); margin-top: 6px; }
  .num { font-size: 0.8125rem; font-weight: 600; color: var(--accent); padding-top: 4px; font-variant-numeric: tabular-nums; }

  @media (max-width: 999px) {
    .grid3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .show, .textgrid { grid-template-columns: minmax(0, 1fr); }
    .stage { min-height: 320px; }
    .stage-art { transform: scale(1.3); }
  }
  @media (max-width: 639px) {
    .grid3, .textlist { grid-template-columns: minmax(0, 1fr); }
  }
</style>
